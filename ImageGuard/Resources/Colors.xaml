<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Теплая палитра: хлопок, тыква, дыня и горький шоколад. -->
    <Color x:Key="BackgroundColor">#F7F0E9</Color>
    <Color x:Key="CardColor">#FFFCF9</Color>
    <Color x:Key="SurfaceMutedColor">#F2E6DE</Color>
    <Color x:Key="PrimaryColor">#D55448</Color>
    <Color x:Key="PrimaryDarkColor">#B9433A</Color>
    <Color x:Key="AccentColor">#FFA577</Color>
    <Color x:Key="SecondaryButtonColor">#FBE2D4</Color>
    <Color x:Key="SecondaryButtonHoverColor">#F5CCB8</Color>
    <Color x:Key="SidebarColor">#896E69</Color>
    <Color x:Key="SidebarHoverColor">#735A56</Color>
    <Color x:Key="SidebarTextColor">#FFF9F5</Color>
    <Color x:Key="SidebarMutedTextColor">#E9DAD5</Color>
    <Color x:Key="SuccessColor">#4F7A63</Color>
    <Color x:Key="WarningColor">#B96735</Color>
    <Color x:Key="ErrorColor">#B83F36</Color>
    <Color x:Key="PrimaryTextColor">#3D302D</Color>
    <Color x:Key="SecondaryTextColor">#725E59</Color>
    <Color x:Key="BorderColor">#E4D1C7</Color>
    <Color x:Key="SuccessSurfaceColor">#DDEBE1</Color>
    <Color x:Key="WarningSurfaceColor">#FCE3D3</Color>
    <Color x:Key="ErrorSurfaceColor">#F6D8D3</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SecondaryButtonBrush" Color="{StaticResource SecondaryButtonColor}" />
    <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="{StaticResource SecondaryButtonHoverColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
    <SolidColorBrush x:Key="SidebarMutedTextBrush" Color="{StaticResource SidebarMutedTextColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="{StaticResource SuccessSurfaceColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="{StaticResource WarningSurfaceColor}" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="{StaticResource ErrorSurfaceColor}" />
</ResourceDictionary>
