<Window x:Class="ImageGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImageGuard — защита цифровых изображений"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="22,24,18,18">
                    <TextBlock Text="ImageGuard"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button x:Name="ProtectNavButton"
                            Style="{StaticResource NavigationButton}"
                            Click="ProtectNavButton_Click"
                            Content="Защита изображения" />
                    <Button x:Name="VerifyNavButton"
                            Style="{StaticResource NavigationButton}"
                            Click="VerifyNavButton_Click"
                            Content="Проверка изображения" />
                    <Button x:Name="ResearchNavButton"
                            Style="{StaticResource NavigationButton}"
                            Click="ResearchNavButton_Click"
                            Content="Исследование" />
                    <Button x:Name="KeysNavButton"
                            Style="{StaticResource NavigationButton}"
                            Click="KeysNavButton_Click"
                            Content="RSA-ключи" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Column="1" />
    </Grid>
</Window>
