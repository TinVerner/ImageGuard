<Window x:Class="ImageGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ImageGuard.ViewModels"
        xmlns:views="clr-namespace:ImageGuard.Views"
        Title="ImageGuard — защита цифровых изображений"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ProtectViewModel}">
            <views:ProtectView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VerifyViewModel}">
            <views:VerifyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:KeysViewModel}">
            <views:KeysView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="22,24,18,18">
                    <TextBlock Text="ImageGuard"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavigationButton}"
                            Command="{Binding ShowProtectCommand}"
                            Tag="{Binding IsProtectActive}"
                            Content="Защита изображения" />
                    <Button Style="{StaticResource NavigationButton}"
                            Command="{Binding ShowVerifyCommand}"
                            Tag="{Binding IsVerifyActive}"
                            Content="Проверка изображения" />
                    <TextBlock Text="Исследование"
                               Foreground="{DynamicResource SidebarMutedTextBrush}"
                               FontSize="14"
                               Margin="28,16,16,16" />
                    <Button Style="{StaticResource NavigationButton}"
                            Command="{Binding ShowKeysCommand}"
                            Tag="{Binding IsKeysActive}"
                            Content="RSA-ключи" />
                </StackPanel>

            </Grid>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
