<UserControl x:Class="ImageGuard.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ImageGuard.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="RSA-ключи" FontSize="28" FontWeight="Bold" />
            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,5,0,14"
                       Text="Создание и проверка пары RSA-ключей в формате PEM." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource Card}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Создать пару ключей" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Имя пары ключей" />
                            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Размер RSA" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding KeySizes}"
                                      SelectedItem="{Binding KeySize}" />

                            <TextBlock Grid.Row="2"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Папка сохранения" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Text="{Binding OutputDirectory}"
                                       Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="2" Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SelectFolderCommand}"
                                    Content="Выбрать папку" />
                        </Grid>

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource LabelText}" Text="Пароль private key" />
                                <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource LabelText}" Text="Повтор пароля" />
                                <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding PasswordConfirmation, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,0,0,4"
                                   Text="Пустой пароль создаст незашифрованный закрытый ключ." />

                        <Button Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Command="{Binding GenerateKeysCommand}"
                                ToolTip="Укажите имя пары ключей и выберите папку сохранения."
                                Content="Создать новую пару ключей" />
                        <ProgressBar Height="5"
                                     Margin="0,5,0,0"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource Card}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Результат" />
                        <TextBlock Text="{Binding ResultText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Fingerprint SHA-256" Margin="0,3,10,5" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Fingerprint}" TextWrapping="Wrap" Margin="0,3,0,5" />
                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Открытый ключ" Margin="0,3,10,5" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PublicKeyPath}" TextWrapping="Wrap" Margin="0,3,0,5" />
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Закрытый ключ" Margin="0,3,10,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PrivateKeyPath}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,7,0,0"
                                   Text="Содержимое закрытого ключа не отображается." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Проверить PEM-ключ" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="145" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="PEM-файл" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="{Binding InspectionPath}"
                                   Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectKeyToInspectCommand}"
                                Content="Выбрать PEM" />

                        <TextBlock Grid.Row="1"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Пароль private key" />
                        <PasswordBox Grid.Row="1" Grid.Column="1"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding InspectionPassword, Mode=TwoWay}" />
                        <Button Grid.Row="1" Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding InspectKeyCommand}"
                                ToolTip="Сначала выберите PEM-файл."
                                Content="Проверить ключ" />
                    </Grid>
                    <TextBlock Text="{Binding InspectionResult}"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
