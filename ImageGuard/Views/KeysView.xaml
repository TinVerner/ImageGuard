<UserControl x:Class="ImageGuard.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="RSA-ключи" FontSize="28" FontWeight="Bold" />
            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,5,0,14"
                       Text="Создание и проверка пары RSA-ключей в формате PEM." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource Card}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Создать пару ключей" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Имя пары ключей" />
                            <TextBox x:Name="KeyNameTextBox"
                                     Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                     Text="mykey"
                                     TextChanged="KeyNameTextBox_TextChanged" />

                            <TextBlock Grid.Row="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Папка сохранения" />
                            <TextBlock x:Name="OutputDirectoryText"
                                       Grid.Row="1" Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="1" Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SelectFolder_Click"
                                    Content="Выбрать папку" />
                        </Grid>

                        <Button x:Name="GenerateButton"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Click="Generate_Click"
                                ToolTip="Укажите имя пары ключей и выберите папку сохранения."
                                Content="Создать новую пару ключей" />
                        <ProgressBar x:Name="BusyProgressBar"
                                     Height="5"
                                     Margin="0,5,0,0"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource Card}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Результат" />
                        <TextBlock x:Name="ResultText"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Fingerprint SHA-256" Margin="0,3,10,5" />
                            <TextBlock x:Name="FingerprintText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,3,0,5" />
                            <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Открытый ключ" Margin="0,3,10,5" />
                            <TextBlock x:Name="PublicKeyPathText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,3,0,5" />
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Закрытый ключ" Margin="0,3,10,0" />
                            <TextBlock x:Name="PrivateKeyPathText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Проверить PEM-ключ" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="135" />
                            <ColumnDefinition Width="135" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="PEM-файл" />
                        <TextBlock x:Name="InspectionPathText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Style="{StaticResource MutedText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Click="SelectKeyToInspect_Click"
                                Content="Выбрать PEM" />
                        <Button x:Name="InspectButton"
                                Grid.Column="3"
                                Style="{StaticResource PrimaryButton}"
                                Click="Inspect_Click"
                                ToolTip="Сначала выберите PEM-файл."
                                Content="Проверить ключ" />
                    </Grid>
                    <TextBlock x:Name="InspectionResultText"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
