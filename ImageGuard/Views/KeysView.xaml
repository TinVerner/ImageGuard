<UserControl x:Class="ImageGuard.Views.KeysView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ImageGuard.Helpers">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="RSA-ключи" FontSize="28" FontWeight="Bold" />
            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,5,0,20"
                       Text="Создание защищенного PKCS#8 private key и открытого SubjectPublicKeyInfo PEM." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Создать пару ключей" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Имя пары ключей" />
                        <TextBox Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Размер RSA" />
                        <ComboBox ItemsSource="{Binding KeySizes}" SelectedItem="{Binding KeySize}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Папка сохранения" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectFolderCommand}"
                                Content="Выбрать папку" />
                        <TextBlock Text="{Binding OutputDirectory}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Пароль private key" />
                        <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Повтор пароля" />
                        <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding PasswordConfirmation, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Пустой пароль создаст незашифрованный PKCS#8. Для практического использования рекомендуется пароль." />

                        <Button Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Command="{Binding GenerateKeysCommand}"
                                ToolTip="Укажите имя пары ключей и выберите папку сохранения."
                                Content="Создать новую пару ключей" />
                        <ProgressBar Height="5"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Результат" />
                        <TextBlock Text="{Binding ResultText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Fingerprint SHA-256" />
                        <TextBlock Text="{Binding Fingerprint}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Открытый ключ" />
                        <TextBlock Text="{Binding PublicKeyPath}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Закрытый ключ" />
                        <TextBlock Text="{Binding PrivateKeyPath}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,12,0,0"
                                   Text="Содержимое закрытого ключа в интерфейсе не отображается и не включается в .igsig." />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Проверить PEM-ключ" />
                    <Button Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding SelectKeyToInspectCommand}"
                            Content="Выбрать PEM" />
                    <TextBlock Text="{Binding InspectionPath}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource LabelText}"
                               Text="Пароль (только для зашифрованного private key)" />
                    <PasswordBox Width="360"
                                 HorizontalAlignment="Left"
                                 helpers:PasswordBoxHelper.BoundPassword="{Binding InspectionPassword, Mode=TwoWay}" />
                    <Button Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding InspectKeyCommand}"
                            ToolTip="Сначала выберите PEM-файл."
                            Content="Проверить ключ" />
                    <TextBlock Text="{Binding InspectionResult}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
