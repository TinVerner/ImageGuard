<UserControl x:Class="ImageGuard.Views.ProtectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:ImageGuard.Helpers"
             xmlns:enums="clr-namespace:ImageGuard.Enums">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Защита изображения" FontSize="28" FontWeight="Bold" />
                <TextBlock Style="{StaticResource MutedText}"
                           Margin="0,5,0,0"
                           Text="Встраивание невидимого DCT-watermark и подпись окончательно сохраненного файла RSA PKCS#1 v1.5/SHA-256." />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Исходное изображение" />
                        <Border Height="230" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8">
                            <Image Source="{Binding SourcePreview}" Stretch="Uniform" Margin="8" />
                        </Border>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,10,0,8"
                                   Text="{Binding ImageInfo}" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectImageCommand}"
                                Content="Выбрать PNG или JPEG" />
                        <TextBlock Text="{Binding InputImagePath}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Защищенное изображение" />
                        <Border Height="230" Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8">
                            <Image Source="{Binding ProtectedPreview}" Stretch="Uniform" Margin="8" />
                        </Border>
                        <TextBlock Text="Предпросмотр появится после сохранения и повторной загрузки файла."
                                   Style="{StaticResource MutedText}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Водяной знак" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Текст идентификатора" />
                        <TextBox Text="{Binding WatermarkText, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="4096"
                                 ToolTip="Например: BSTU-TEST-001" />
                        <TextBlock Style="{StaticResource MutedText}">
                            <Run Text="UTF-8: " />
                            <Run Text="{Binding WatermarkByteCount, Mode=OneWay}" />
                            <Run Text=" байт" />
                        </TextBlock>
                        <TextBlock Text="{Binding CapacityInfo}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,6,0,10" />

                        <TextBlock Style="{StaticResource LabelText}"
                                   Text="Delta — минимальная разность коэффициентов" />
                        <TextBox Width="150"
                                 HorizontalAlignment="Left"
                                 Text="{Binding WatermarkSettings.Delta, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                 ToolTip="Фиксированная сила встраивания. Значение по умолчанию: 10." />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Один бит записывается в один блок 8×8 через фиксированные коэффициенты F(2,3) и F(3,2)." />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Ключ и сохранение" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Закрытый RSA-ключ" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectPrivateKeyCommand}"
                                Content="Выбрать .private.pem" />
                        <TextBlock Text="{Binding PrivateKeyPath}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Пароль закрытого ключа" />
                        <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding PrivateKeyPassword, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource LabelText}" Text="Формат результата" />
                        <ComboBox SelectedValue="{Binding OutputFormat}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="PNG (рекомендуется)"
                                          Tag="{x:Static enums:ImageOutputFormat.Png}" />
                            <ComboBoxItem Content="JPEG"
                                          Tag="{x:Static enums:ImageOutputFormat.Jpeg}" />
                        </ComboBox>
                        <StackPanel Visibility="{Binding IsJpeg, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource LabelText}" Text="Качество JPEG (1–100)" />
                            <TextBox Text="{Binding JpegQuality, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                        </StackPanel>

                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectOutputCommand}"
                                Content="Выбрать файл результата" />
                        <TextBlock Text="{Binding OutputImagePath}"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SignatureOutputPath}"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding ProtectCommand}"
                                ToolTip="Сначала выберите изображение, введите watermark, укажите private key и файл результата."
                                Content="Защитить изображение" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}"
                                Content="Отмена" />
                    </WrapPanel>
                    <ProgressBar Height="5"
                                 Margin="0,8,0,8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding ResultText}"
                               Margin="0,10,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SHA-256:" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Sha256}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="PSNR:" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PsnrText}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="MSE (RGB):" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MseText}" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Время:" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProcessingTime}" Margin="0,5,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
