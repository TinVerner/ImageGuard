<UserControl x:Class="ImageGuard.Views.ProtectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Защита изображения" FontSize="28" FontWeight="Bold" />
                <TextBlock Style="{StaticResource MutedText}"
                           Margin="0,5,0,0"
                           Text="Встраивание цифрового водяного знака и создание цифровой подписи." />
            </StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Изображения" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Исходное изображение" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <Border Height="180"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="7">
                                <Image x:Name="SourcePreviewImage" Stretch="Uniform" Margin="7" />
                            </Border>
                            <TextBlock x:Name="ImageInfoText"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,7,0,2"
                                       Text="Изображение не выбрано" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Left"
                                    Click="SelectImage_Click"
                                    Content="Выбрать PNG" />
                            <TextBlock x:Name="InputImagePathText"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Защищённое изображение" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <Border Height="180"
                                    Background="{DynamicResource SurfaceMutedBrush}"
                                    CornerRadius="7">
                                <Image x:Name="ProtectedPreviewImage" Stretch="Uniform" Margin="7" />
                            </Border>
                            <TextBlock Text="Предпросмотр появится после сохранения файла."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,7,0,2" />
                            <TextBlock x:Name="OutputImagePathText"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="11*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource Card}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Водяной знак" />
                        <TextBlock Style="{StaticResource LabelText}" Text="Текст идентификатора" />
                        <TextBox x:Name="WatermarkTextBox"
                                 MaxLength="4096"
                                 ToolTip="Например: BSTU-TEST-001"
                                 TextChanged="WatermarkTextBox_TextChanged" />
                        <TextBlock x:Name="WatermarkByteCountText"
                                   Style="{StaticResource MutedText}"
                                   Text="UTF-8: 0 байт" />
                        <TextBlock x:Name="CapacityInfoText"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,4,0,7"
                                   Text="Выберите изображение и введите текст." />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,4"
                                       FontWeight="SemiBold"
                                       Text="Delta" />
                            <TextBox x:Name="DeltaTextBox"
                                     Grid.Column="1"
                                     Text="10"
                                     ToolTip="Фиксированная сила встраивания. Значение по умолчанию: 10." />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource Card}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Ключ и сохранение" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Закрытый RSA-ключ" />
                            <TextBlock x:Name="PrivateKeyPathText"
                                       Grid.Row="0" Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="0" Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SelectPrivateKey_Click"
                                    Content="Выбрать private.pem" />

                            <TextBlock Grid.Row="1"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="Файл результата" />
                            <TextBlock x:Name="OutputPathShortText"
                                       Grid.Row="1" Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource MutedText}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Row="1" Grid.Column="2"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="SelectOutput_Click"
                                    Content="Выбрать файл" />

                            <TextBlock Grid.Row="2"
                                       VerticalAlignment="Top"
                                       Margin="0,4,0,0"
                                       FontWeight="SemiBold"
                                       Text="Файл подписи" />
                            <TextBlock x:Name="SignatureOutputPathText"
                                       Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Button x:Name="ProtectButton"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left"
                            Click="Protect_Click"
                            ToolTip="Сначала выберите изображение, введите watermark, укажите private key и файл результата."
                            Content="Защитить изображение" />
                    <ProgressBar x:Name="OperationProgressBar"
                                 Height="5"
                                 Margin="0,8,0,8"
                                 Minimum="0"
                                 Maximum="100"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" Text="Готово к работе" />
                    <TextBlock x:Name="ResultText"
                               Margin="0,7,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SHA-256:" FontWeight="SemiBold" />
                        <TextBlock x:Name="Sha256Text" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Время:" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock x:Name="ProcessingTimeText" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
