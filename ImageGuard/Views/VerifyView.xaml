<UserControl x:Class="ImageGuard.Views.VerifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:ImageGuard.Enums">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Проверка изображения" FontSize="28" FontWeight="Bold" />
            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,5,0,20"
                       Text="RSA-подпись и встроенный watermark проверяются независимо друг от друга." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Файлы проверки" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Изображение" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding ImagePath}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectImageCommand}" Content="Выбрать..." />

                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Подпись .igsig" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding SignaturePath}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectSignatureCommand}" Content="Выбрать..." />

                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Открытый RSA-ключ" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding PublicKeyPath}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectPublicKeyCommand}" Content="Выбрать..." />
                    </Grid>

                    <WrapPanel Margin="0,14,0,4">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding VerifyCommand}"
                                ToolTip="Сначала выберите изображение, .igsig и открытый RSA-ключ."
                                Content="Проверить" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}"
                                Content="Отмена" />
                    </WrapPanel>
                    <ProgressBar Height="5"
                                 Margin="0,8,0,8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Цифровая подпись" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SignatureText}" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,8,0,0"
                                   Text="Проверяется RSA.VerifyData с SHA-256 и PKCS#1 v1.5." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Цифровой водяной знак" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding WatermarkText}" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0">
                            <Run Text="Извлеченный текст: " />
                            <Run Text="{Binding ExtractedWatermark, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="20" CornerRadius="10" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OverallStatus}"
                                         Value="{x:Static enums:OverallVerificationStatus.Authentic}">
                                <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OverallStatus}"
                                         Value="{x:Static enums:OverallVerificationStatus.ModifiedWatermarkPreserved}">
                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OverallStatus}"
                                         Value="{x:Static enums:OverallVerificationStatus.Inconsistent}">
                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Общий итог" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding OverallText}"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Технические сведения" />
                    <TextBlock Style="{StaticResource LabelText}" Text="Текущий SHA-256" />
                    <TextBlock Text="{Binding CurrentSha256}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource LabelText}" Text="SHA-256 из .igsig" />
                    <TextBlock Text="{Binding StoredSha256}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource LabelText}" Text="Fingerprint выбранного ключа" />
                    <TextBlock Text="{Binding ActualFingerprint}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource LabelText}" Text="Fingerprint из .igsig" />
                    <TextBlock Text="{Binding ExpectedFingerprint}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource LabelText}" Text="Совпадение fingerprint" />
                    <TextBlock Text="{Binding FingerprintMatchText}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource LabelText}" Text="Время обработки" />
                    <TextBlock Text="{Binding ProcessingTime}" />
                    <TextBlock Text="{Binding Details}"
                               Foreground="{DynamicResource WarningBrush}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
