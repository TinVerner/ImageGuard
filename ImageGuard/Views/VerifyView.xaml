<UserControl x:Class="ImageGuard.Views.VerifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:ImageGuard.Enums">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="Проверка изображения" FontSize="28" FontWeight="Bold" />
            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,5,0,14"
                       Text="Проверка цифровой подписи и извлечение цифрового водяного знака." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Файлы проверки" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="145" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Изображение" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="{Binding ImagePath}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectImageCommand}" Content="Выбрать..." />

                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Подпись .igsig" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="{Binding SignaturePath}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectSignatureCommand}" Content="Выбрать..." />

                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Открытый RSA-ключ" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Text="{Binding PublicKeyPath}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectPublicKeyCommand}" Content="Выбрать..." />
                    </Grid>

                    <WrapPanel Margin="0,8,0,2"
                               HorizontalAlignment="Right">
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding VerifyCommand}"
                                ToolTip="Сначала выберите изображение, .igsig и открытый RSA-ключ."
                                Content="Проверить" />
                        <Button Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}"
                                Content="Отмена" />
                    </WrapPanel>
                    <ProgressBar Height="5"
                                 Margin="0,6,0,6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Style="{StaticResource Card}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Цифровая подпись" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding SignatureText}" FontSize="19" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2"
                        Style="{StaticResource Card}"
                        VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Цифровой водяной знак" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding WatermarkText}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0">
                            <Run Text="Текст: " />
                            <Run Text="{Binding ExtractedWatermark, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Padding="14" CornerRadius="9" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OverallStatus}"
                                         Value="{x:Static enums:OverallVerificationStatus.Authentic}">
                                <Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OverallStatus}"
                                         Value="{x:Static enums:OverallVerificationStatus.ModifiedWatermarkPreserved}">
                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OverallStatus}"
                                         Value="{x:Static enums:OverallVerificationStatus.Inconsistent}">
                                <Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Общий результат" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding OverallText}"
                               Grid.Column="1"
                               FontSize="17"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Технические сведения" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="SHA-256" Margin="0,2,12,5" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentSha256}" TextWrapping="Wrap" Margin="0,2,0,5" />
                        <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="SHA-256 из .igsig" Margin="0,2,12,5" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StoredSha256}" TextWrapping="Wrap" Margin="0,2,0,5" />
                        <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Fingerprint выбранного ключа" Margin="0,2,12,5" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActualFingerprint}" TextWrapping="Wrap" Margin="0,2,0,5" />
                        <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Fingerprint из .igsig" Margin="0,2,12,5" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpectedFingerprint}" TextWrapping="Wrap" Margin="0,2,0,5" />
                        <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Совпадение fingerprint" Margin="0,2,12,5" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FingerprintMatchText}" Margin="0,2,0,5" />
                        <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Время обработки" Margin="0,2,12,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProcessingTime}" Margin="0,2,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding Details}"
                               Foreground="{DynamicResource WarningBrush}"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
